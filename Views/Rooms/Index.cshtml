@model List<StudyRoomBooking.Models.Room>
@{
    ViewData["Title"] = "Rooms";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <span class="section-eyebrow">Facilities</span>
        <h1 class="h2 fw-bold mt-1 mb-2">Study Rooms</h1>
        <p class="text-secondary-emphasis mb-0">
            @if (Model.Count > 0)
            {
                <span>@Model.Count @(Model.Count == 1 ? "room" : "rooms") available for booking.</span>
            }
            else
            {
                <span>Browse the rooms that are available to book.</span>
            }
        </p>
    </div>

</div>

@if (Model.Count > 0)
{
    <div class="row g-4">
        @foreach (var room in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card card-hover h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                           
                            <span class="badge badge-soft-primary rounded-pill px-3 py-2">
                                @room.Capacity @(room.Capacity == 1 ? "seat" : "seats")
                            </span>
                        </div>

                        <h2 class="h5 fw-bold mb-1">Room @room.RoomNumber</h2>
                        <p class="text-secondary-emphasis d-flex align-items-center mb-0">
                     
                            @room.Building
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-top-0 px-4 pb-4">
                        <a class="btn btn-outline-primary w-100" asp-controller="Bookings" asp-action="Create">
                            Book this room
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="card-body empty-state">
            
            <h2 class="h5 fw-bold">No study rooms available</h2>
            <p class="text-secondary-emphasis mb-4">There are no rooms registered yet. Check back again later.</p>
            <a class="btn btn-outline-primary px-4" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>
    </div>
}