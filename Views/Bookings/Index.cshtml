@model List<StudyRoomBooking.Models.Booking>

<h1>Study Sessions</h1>

<a asp-action="Create">Create Study Session</a>

@if (Model.Count == 0)
{
    <p>No study sessions have been created yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Subject</th>
                <th>Topic</th>
                <th>Student</th>
                <th>Room</th>
                <th>Start</th>
                <th>End</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Subject</td>
                    <td>@booking.Topic</td>
                    <td>@booking.StudentName</td>
                    <td>@booking.RoomId</td>
                    <td>@booking.StartTime</td>
                    <td>@booking.EndTime</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@booking.Id">
                            Details
                        </a>

                        <a asp-action="Edit" asp-route-id="@booking.Id">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@booking.Id"
                              method="post"
                              style="display:inline;">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}