<!DOCTYPE html>
@{
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "";
}
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyRoomBooking</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudyRoomBooking.Mvc.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="bg-white border-bottom sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">

                <a class="navbar-brand fw-bold text-dark" asp-controller="Home" asp-action="Index">
                    StudyRoomBooking
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">



                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-controller="Rooms" asp-action="Index">
                                Rooms
                            </a>
                        </li>



                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown"
                                onmouseenter="this.querySelector('.dropdown-menu').classList.add('show')"
                                onmouseleave="this.querySelector('.dropdown-menu').classList.remove('show')">

                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">

                                    @User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span>(Admin)</span>
                                    }
                                    else
                                    {
                                        <span>(User)</span>
                                    }
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Courses" asp-action="Index">
                                                Courses
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="Bookings" asp-action="Index">
                                            My Bookings
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger">
                                                Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {

                            <li class="nav-item">
                                <div class="d-flex align-items-center">
                                    <a class="nav-link fw-semibold text-dark px-1 auth-link" asp-controller="Account"
                                       asp-action="Login">
                                        Login
                                    </a>

                                    <span class="text-secondary">/</span>

                                    <a class="nav-link fw-semibold text-dark px-1 auth-link" asp-controller="Account"
                                       asp-action="Register">
                                        Register
                                    </a>
                                </div>
                            </li>

                        }

                        <li class="nav-item mt-2 mt-lg-0">
                            <a class="btn btn-primary px-3 " asp-controller="Bookings" asp-action="Create">
                                New booking
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <main role="main" class="container ">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>&copy; @DateTime.Now.Year - StudyRoomBooking</div>
            <div class="d-flex gap-4">
                <a asp-area="" asp-controller="Rooms" asp-action="Index">Rooms</a>
                <a asp-area="" asp-controller="Bookings" asp-action="Index">Bookings</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

