@{
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Study Room Booking</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudyRoomBooking.Mvc.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand site-brand d-inline-flex align-items-center gap-2" asp-area=""
                   asp-controller="Home" asp-action="Index" aria-label="Study Room Booking home">
                    <span>Study Room Booking</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <div
                        class="site-header-actions d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 mt-3 mt-lg-0 ms-lg-auto">
                        @if (signedIn)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light border dropdown-toggle w-100" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.Identity?.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-lg-end">
                                    <li><span class="dropdown-item-text small text-secondary">Signed in as
                                        @User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value</span>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Admin</a></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-controller="Bookings" asp-action="Index">My
                                            Bookings</a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                        <li>
                                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"><button
                                                type="submit" class="dropdown-item">Log out</button></form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                        else
                                {
                                    <a class="btn btn-outline-dark" asp-area="" asp-controller="Account" asp-action="Login">Log
                                        in</a>
                                        <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Create
                                            account</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </nav>
                    </header>

                    <main role="main" class="container flex-grow-1">
                        @RenderBody()
                    </main>

                    <footer class="footer">
                        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                            <div>&copy; @DateTime.Now.Year - Study Room Booking</div>
                            <div class="d-flex gap-4">
                                <a asp-area="" asp-controller="Rooms" asp-action="Index">Rooms</a>
                                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </div>
                        </div>
                    </footer>

                    <script src="~/lib/jquery/dist/jquery.min.js"></script>
                    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                    <script src="~/js/site.js" asp-append-version="true"></script>
                    @await RenderSectionAsync("Scripts", required: false)
                </body>

            </html>
