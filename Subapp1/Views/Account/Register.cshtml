@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5" style="max-width: 420px;">
    <h2 class="mb-2">Create an account</h2>
    <p class="text-muted mb-4">
        Register to start booking study rooms.
    </p>

    <form asp-controller="Account" asp-action="Register" method="post">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="userId" class="form-label">
                User ID
            </label>
            <input id="userId" name="userId" class="form-control" minlength="3" maxlength="50"
                   autocomplete="username" required />
        </div>

        <div class="mb-3">
            <label for="name" class="form-label">
                Name
            </label>
            <input id="name" name="name" class="form-control" minlength="3" maxlength="50" autocomplete="name"
                   required />
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">
                Email
            </label>
            <input id="email" name="email" type="email" class="form-control" minlength="3" maxlength="50"
                   autocomplete="email" required />
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">
                Password
            </label>
            <input id="password" name="password" type="password" class="form-control" minlength="8"
                   autocomplete="new-password" required />
            <small class="text-muted">
                Must contain at least 8 characters.
            </small>
        </div>

        <div class="mb-3">
            <label for="confirmPassword" class="form-label">
                Confirm password
            </label>
            <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" minlength="8"
                   autocomplete="new-password" required />
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        <button type="submit" class="btn btn-primary w-100">
            Create account
        </button>
    </form>

    <p class="text-center mt-4">
        Already have an account?
        <a asp-controller="Account" asp-action="Login">
            Log in
        </a>
    </p>
</div>
