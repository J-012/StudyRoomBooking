@model IEnumerable<StudyRoomBooking.Models.Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="py-5">
    <div class="mb-4">
        <span class="section-eyebrow">Explore courses</span>
        <h1 class="h2 fw-bold mt-1 mb-2">Courses</h1>
        <p class="text-secondary-emphasis mb-0">Explore available courses and find your next study session.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-journal-bookmark fs-1 text-secondary" aria-hidden="true"></i>
                <h2 class="h5 fw-bold mt-3">No courses available</h2>
                <p class="text-secondary mb-0">There are currently no courses to display.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body p-4">
                            <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-2">@course.CourseCode</span>
                            <h2 class="h5 fw-bold mt-3 mb-2">@course.Name</h2>
                            <p class="text-secondary small mb-0">
                                @(string.IsNullOrWhiteSpace(course.Description) ? "No description available." : course.Description)
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
