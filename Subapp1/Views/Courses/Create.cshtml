@model StudyRoomBooking.Models.Course

@{
    ViewData["Title"] = "Create Course";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-xl-9">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a asp-controller="Courses" asp-action="Index">Courses</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    Create
                </li>
            </ol>
        </nav>

        <div class="mb-4">
            <span class="section-eyebrow">Course management</span>
            <h1 class="h2 fw-bold mt-1 mb-2">Create Course</h1>
            <p class="text-secondary-emphasis mb-0">
                Add a new course that students can select when booking study rooms.
                Fields marked with <span class="text-danger">*</span> are required.
            </p>
        </div>

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <form asp-controller="Courses" asp-action="Create" method="post">

            <div class="card mb-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-bold mb-4">Course details</h2>

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label asp-for="CourseCode" class="form-label">
                                Course Code <span class="text-danger">*</span>
                            </label>

                            <input asp-for="CourseCode"
                                   class="form-control"
                                   placeholder="e.g. DATA1500"
                                   maxlength="20" />

                            <span asp-validation-for="CourseCode"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Name" class="form-label">
                                Course Name <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="e.g. Databases"
                                   maxlength="100" />

                            <span asp-validation-for="Name"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Write a short description of the course..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                Maximum 500 characters.
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end">
                <a asp-controller="Courses"
                   asp-action="Index"
                   class="btn btn-light px-4">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-plus-lg me-1"></i>
                    Create Course
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}