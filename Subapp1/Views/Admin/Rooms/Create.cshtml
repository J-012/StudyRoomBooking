@model StudyRoomBooking.ViewModels.Admin.RoomFormViewModel
@{ ViewData["Title"] = "Add room"; }

<div class="row justify-content-center py-5"><div class="col-12 col-lg-7">
    <div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
        <h1 class="h3 fw-bold">Add room</h1>
        <p class="text-secondary">Choose its building and available facilities.</p>
        <form asp-action="AdminCreate" method="post">
            <partial name="~/Views/Admin/Rooms/_RoomForm.cshtml" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <a asp-action="AdminIndex" class="btn btn-outline-secondary">Cancel</a>
                <button class="btn btn-primary" type="submit">Add room</button>
            </div>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
