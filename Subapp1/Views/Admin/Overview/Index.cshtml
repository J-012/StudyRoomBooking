@model StudyRoomBooking.ViewModels.Admin.AdminOverviewViewModel
@{
    ViewData["Title"] = "Admin overview";
}

<section class="mt-5" aria-labelledby="admin-manage-heading">
    <div class="mb-3">
        <h2 id="admin-manage-heading" class="h4 fw-bold mb-1">Manage</h2>
        <p class="text-secondary mb-0">Choose what you want to update.</p>
    </div>
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <a class="admin-overview-link" asp-controller="Rooms" asp-action="AdminIndex">
                <span class="admin-overview-link-top">
                    <span class="admin-overview-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"
                                                                              stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="3" width="16" height="18" rx="2" />
                        <path d="M9 21V9h6v12M8 6h.01M16 6h.01" />
                    </svg></span>
                    <span class="admin-overview-arrow" aria-hidden="true">↗</span>
                </span>
                <strong>Rooms</strong>
                <span class="admin-overview-link-description">Edit rooms, capacity, and assigned amenities.</span>
            </a>
        </div>
        <div class="col-12 col-md-6">
            <a class="admin-overview-link" asp-controller="Buildings" asp-action="Index">
                <span class="admin-overview-link-top">
                    <span class="admin-overview-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"
                                                                              stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 21h18M5 21V5l8-2v18M13 21V9l6-2v14M8 8h2M8 12h2M8 16h2M16 12h1M16 16h1" />
                    </svg></span>
                    <span class="admin-overview-arrow" aria-hidden="true">↗</span>
                </span>
                <strong>Buildings</strong>
                <span class="admin-overview-link-description">Keep locations and addresses up to date.</span>
            </a>
        </div>

        <div class="col-12 col-md-6">
            <a class="admin-overview-link" asp-controller="Courses" asp-action="AdminIndex">
                <span class="admin-overview-link-top">
                    <span class="admin-overview-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"
                                                                              stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path
                        d="M12 6c-2.3-1.6-5-1.8-9-1v14c4-.8 6.7-.6 9 1 2.3-1.6 5-1.8 9-1V5c-4-.8-6.7-.6-9 1ZM12 6v14" />
                    </svg></span>
                    <span class="admin-overview-arrow" aria-hidden="true">↗</span>
                </span>
                <strong>Courses</strong>
                <span class="admin-overview-link-description">Manage course names and descriptions.</span>
            </a>
        </div>
    </div>
</section>
