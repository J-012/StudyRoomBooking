@model IEnumerable<StudyRoomBooking.Models.Building>
@{ ViewData["Title"] = "Buildings"; }
<div class="py-5">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div><h1 class="h2 fw-bold mb-1">Buildings</h1><p class="text-secondary mb-0">Explore the locations of our study rooms.</p></div>
        @if (User.IsInRole("Admin")) { <a asp-action="Create" class="btn btn-primary">Add building</a> }
    </div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="alert">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (!Model.Any()) { <div class="card"><div class="card-body py-5 text-center text-secondary">No buildings have been added yet.</div></div> }
    <div class="row g-3" data-load-more data-load-more-size="9" data-load-more-label="buildings">
        @{ var buildingIndex = 0; }
        @foreach (var building in Model)
        {
            <div class="col-12 col-md-6 @(buildingIndex >= 9 ? "d-none" : "")" data-load-more-item><div class="card h-100"><div class="card-body p-4">
                <h2 class="h5 fw-bold">@building.Name</h2>
                <p class="text-secondary mb-0">@(string.IsNullOrWhiteSpace(building.Address) ? "Address not provided" : building.Address)</p>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="card-footer bg-transparent d-flex gap-2 p-3">
                    <a asp-action="Edit" asp-route-id="@building.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-id="@building.Id" method="post" onsubmit="return confirm('Delete this building? Rooms must be moved first.');">
                        <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                    </form>
                </div>
            }
            </div></div>
            buildingIndex++;
        }
    </div>
    @if (Model.Count() > 9)
    {
        <div class="text-center mt-4" data-load-more-controls>
            <p class="small text-secondary mb-2" data-load-more-count aria-live="polite">
                Showing 9 of @Model.Count() buildings
            </p>
            <button type="button" class="btn btn-outline-secondary" data-load-more-button>
                Load 9 more buildings
            </button>
        </div>
    }
</div>
