@model StudyRoomBooking.ViewModels.RoomsIndexViewModel
@using System.Security.Claims
@using System.Globalization

@{
    ViewData["Title"] = "Study Rooms";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var dateValue = Model.Date.ToString("yyyy-MM-dd");
    var startValue = Model.StartTime.ToString(@"hh\:mm");
    var endValue = Model.EndTime.ToString(@"hh\:mm");
    var visibleBuildings = Model.Buildings.Take(5).ToList();
    var additionalBuildings = Model.Buildings.Skip(5).ToList();
    var selectedStart = Model.Date.Date + Model.StartTime;
    var selectedEnd = Model.Date.Date + Model.EndTime;
    string? selectedIntervalError = null;

    if (selectedEnd <= selectedStart)
    {
        selectedIntervalError = "Choose an end time after the start time.";
    }
    else if ((selectedEnd - selectedStart).TotalMinutes < 15)
    {
        selectedIntervalError = "Choose a booking duration of at least 15 minutes.";
    }
    else if ((selectedEnd - selectedStart).TotalMinutes > 180)
    {
        selectedIntervalError = "Bookings can last up to three hours.";
    }
    else if (selectedStart < DateTime.Now)
    {
        selectedIntervalError = "Choose a future start time.";
    }
}

<div class="row g-4 mb-4 py-3">
    <aside class="col-12 col-md-6 col-lg-3">
        <form id="roomFilters" asp-controller="Rooms" asp-action="Index" method="get"
              class="card border rounded-3 h-100">
            <div class="card-body p-3 p-lg-3    ">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h5 fw-bold mb-0">Filter rooms</h2>
                    <a asp-controller="Rooms" asp-action="Index" class="small text-decoration-none">Clear all</a>
                </div>

                <div class="mb-4">
                    <label asp-for="SearchTerm" class="form-label fw-semibold">Search</label>
                    <input asp-for="SearchTerm" class="form-control" placeholder="Room or building" />
                </div>


                <div class="mb-4">
                    <label class="form-label fw-semibold">Availability</label>
                    <input asp-for="Status" type="hidden" id="statusFilter" />
                    <div class="d-flex flex-wrap gap-2" role="group" aria-label="Availability filter">
                        @foreach (var option in new[] { ("all", "All rooms"), ("available", "Available"), ("booked",
       "Booked") })
                        {
                            <button type="button"
                                    class="btn btn-sm @(Model.Status == option.Item1 ? "btn-primary" : "btn-outline-secondary")"
                                    data-status-option="@option.Item1">@option.Item2</button>
                        }
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="Date" class="form-label fw-semibold">Date</label>
                    <input asp-for="Date" type="date" value="@dateValue" class="form-control" id="roomDateFilter" />
                </div>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <label asp-for="StartTime" class="form-label fw-semibold">Start</label>
                        <input asp-for="StartTime" type="time" value="@startValue" step="3600" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label asp-for="EndTime" class="form-label fw-semibold">End</label>
                        <input asp-for="EndTime" type="time" value="@endValue" step="3600" class="form-control" />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Building</label>
                    <input asp-for="Building" type="hidden" id="buildingFilter" />
                    <div class="d-flex flex-wrap gap-2" role="group" aria-label="Building filter">
                        <button type="button"
                                class="btn btn-sm @(string.IsNullOrWhiteSpace(Model.Building) ? "btn-primary" : "btn-outline-secondary")"
                                data-building-option="">All buildings</button>
                        @foreach (var building in visibleBuildings)
                        {
                            <button type="button"
                                    class="btn btn-sm @(string.Equals(Model.Building, building, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")"
                                    data-building-option="@building">@building</button>
                        }
                        @if (additionalBuildings.Any())
                        {
                            <div id="moreBuildings" class="d-none contents">
                                @foreach (var building in additionalBuildings)
                                {
                                    <button type="button"
                                            class="btn btn-sm @(string.Equals(Model.Building, building, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")"
                                            data-building-option="@building">@building</button>
                                }
                            </div>
                            <button type="button" id="showMoreBuildings"
                                    class="btn btn-sm btn-link px-0 text-decoration-none">Load more
                                (@additionalBuildings.Count)</button>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="MinCapacity" class="form-label fw-semibold">Minimum capacity</label>
                        <input asp-for="MinCapacity" type="number" min="1" class="form-control"
                               placeholder="Number of seats" />
                    </div>

                    <p class="small text-secondary mb-0">Results update when you change a filter.</p>
                    <div asp-validation-summary="All" class="text-danger small mt-3"></div>
                </div>
            </form>
        </aside>

        <div class="col-12 col-lg-9">
            <div class="py-5">
                <span class="text-uppercase text-secondary small fw-semibold">
                    Facilities
                </span>

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2">
                    <div>
                        <h1 class="h2 fw-bold mt-1 mb-2">Study Rooms</h1>
                        <p class="text-secondary mb-0">
                            Find an available room or join an existing study session.
                        </p>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <span class="badge rounded-pill border px-3 py-2 text-dark"
                              style="background-color: var(--srb-hero-bg);">
                            @Model.Rooms.Count @(Model.Rooms.Count == 1 ? "room" : "rooms") found
                        </span>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Rooms" asp-action="Create" class="btn btn-primary">
                                + Add Room
                            </a>
                        }
                    </div>
                </div>
            </div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["Error"]
                </div>
            }

            @if (Model.Rooms.Any())
            {
                <div class="row g-3">
                    @foreach (var room in Model.Rooms)
                    {
                        var isBooked = room.Bookings.Any();
                        var canBookRoom = !isBooked && selectedIntervalError is null;

                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="card room-card h-100">

                                <div class="card-body p-3 p-md-4">

                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="room-number">
                                            <span class="small text-secondary d-block mb-1">
                                                STUDY ROOM
                                            </span>

                                            <h2 class="h4 fw-bold mb-0">
                                                @room.RoomNumber
                                            </h2>
                                        </div>

                                        <span class="room-capacity">
                                            <span class="fw-semibold">
                                                @room.Capacity
                                            </span>
                                            <span class="small">
                                                @(room.Capacity == 1 ? "seat" : "seats")
                                            </span>
                                        </span>
                                    </div>

                                    <div class="border-top pt-3 mt-3">
                                        <p class="small text-secondary mb-1">
                                            Building
                                        </p>

                                        <p class="fw-semibold mb-3">
                                            @room.Building
                                        </p>

                                        @if (isBooked)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis">
                                                Booked
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis">
                                                Available
                                            </span>
                                        }
                                    </div>

                                    @if (isBooked)
                                    {
                                        <div class="border-top mt-3 pt-3">

                                            <p class="small fw-semibold mb-3">
                                                Study sessions
                                            </p>

                                            @foreach (var booking in room.Bookings.OrderBy(b => b.StartTime))
                                            {
                                                var occupied = booking.Participants.Count + 1;
                                                var isFull = occupied >= room.Capacity;
                                                var isOwner = booking.UserId == currentUserId;

                                                var hasJoined = booking.Participants.Any(
                                                    bp => bp.Participant.UserId == currentUserId);

                                                var hasStarted = booking.StartTime <= DateTime.Now;

                                                <div class="border rounded-3 p-3 mb-3">

                                                    <div class="d-flex justify-content-between gap-2 mb-2">
                                                        <span class="fw-semibold">
                                                            @booking.Topic
                                                        </span>

                                                        <span class="badge bg-light text-dark border">
                                                            @occupied / @room.Capacity
                                                        </span>
                                                    </div>

                                                    <p class="small text-secondary mb-2">
                                                        @booking.StartTime.ToString("dd MMM yyyy")
                                                        ·
                                                        @booking.StartTime.ToString("HH:mm")
                                                        -
                                                        @booking.EndTime.ToString("HH:mm")
                                                    </p>

                                                    <p class="small text-secondary mb-3">
                                                        Hosted by @booking.UserName
                                                    </p>

                                                    @if (isOwner)
                                                    {
                                                        <span class="btn btn-outline-secondary w-100 disabled">
                                                            Your session
                                                        </span>
                                                    }
                                                    else if (hasJoined)
                                                    {
                                                        <form asp-controller="Bookings" asp-action="Leave" asp-route-id="@booking.BookingId"
                                                              method="post">

                                                            <input type="hidden" name="returnToRooms" value="true" />

                                                            <button type="submit" class="btn btn-outline-danger w-100">
                                                                Leave session
                                                            </button>
                                                        </form>
                                                    }
                                                    else if (hasStarted)
                                                    {
                                                        <button class="btn btn-secondary w-100" disabled>
                                                            Session started
                                                        </button>
                                                    }
                                                    else if (isFull)
                                                    {
                                                        <button class="btn btn-secondary w-100" disabled>
                                                            Session full
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <form asp-controller="Bookings" asp-action="Join" asp-route-id="@booking.BookingId"
                                                              method="post">

                                                            <input type="hidden" name="returnToRooms" value="true" />

                                                            <button type="submit" class="btn btn-primary w-100">
                                                                Join session
                                                            </button>
                                                        </form>
                                                    }

                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="card-footer px-3 px-md-4 pb-3 pb-md-4 pt-0">

                                    @if (canBookRoom)
                                    {
                                        <a asp-controller="Bookings" asp-action="Create" asp-route-roomId="@room.Id"
                                           asp-route-date="@dateValue" asp-route-startTime="@startValue" asp-route-endTime="@endValue"
                                           class="btn btn-room w-100 fw-semibold">

                                            Book this room
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary w-100 fw-semibold" disabled
                                                title="@(selectedIntervalError ?? "This room is unavailable for the selected time.")">
                                            @(selectedIntervalError ?? "Room unavailable")
                                        </button>
                                    }

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="d-flex gap-2 mt-2">

                                            <a asp-controller="Rooms" asp-action="Edit" asp-route-id="@room.Id"
                                               class="btn btn-room flex-grow-1">
                                                Edit
                                            </a>

                                            <form asp-controller="Rooms" asp-action="Delete" asp-route-id="@room.Id" method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this room?');">

                                                <button type="submit" class="btn btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border rounded-3 shadow-sm">
                    <div class="card-body text-center py-5 px-4">

                        <h2 class="h5 fw-bold mb-2">
                            No rooms found
                        </h2>

                        <p class="text-secondary mb-4">
                            No rooms match your selected filters.
                        </p>

                        <a asp-controller="Rooms" asp-action="Index" class="btn btn-room fw-semibold px-4">
                            Clear filters
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    @section Scripts {
        <script>
            const roomFilters = document.getElementById('roomFilters');

            const dateFilter = document.getElementById('roomDateFilter');
            let dateUpdateTimer;

            roomFilters.addEventListener('change', event => {
                if (event.target !== dateFilter) {
                    roomFilters.requestSubmit();
                }
            });

            const scheduleDateUpdate = () => {
                clearTimeout(dateUpdateTimer);
                dateUpdateTimer = setTimeout(() => roomFilters.requestSubmit(), 1100);
            };

            dateFilter.addEventListener('input', scheduleDateUpdate);
            dateFilter.addEventListener('change', scheduleDateUpdate);

            document.querySelectorAll('[data-status-option]').forEach(button => {
                button.addEventListener('click', () => {
                    const statusFilter = document.getElementById('statusFilter');
                    statusFilter.value = button.dataset.statusOption;
                    document.querySelectorAll('[data-status-option]').forEach(item => {
                        item.classList.toggle('btn-primary', item === button);
                        item.classList.toggle('btn-outline-secondary', item !== button);
                    });
                    statusFilter.dispatchEvent(new Event('change', { bubbles: true }));
                });
            });

            document.querySelectorAll('[data-building-option]').forEach(button => {
                button.addEventListener('click', () => {
                    const buildingFilter = document.getElementById('buildingFilter');
                    buildingFilter.value = button.dataset.buildingOption;
                    document.querySelectorAll('[data-building-option]').forEach(item => {
                        item.classList.toggle('btn-primary', item === button);
                        item.classList.toggle('btn-outline-secondary', item !== button);
                    });
                    buildingFilter.dispatchEvent(new Event('change', { bubbles: true }));
                });
            });

            const moreBuildings = document.getElementById('moreBuildings');
            const showMoreBuildings = document.getElementById('showMoreBuildings');
            if (moreBuildings && showMoreBuildings) {
                showMoreBuildings.addEventListener('click', () => {
                    const isHidden = moreBuildings.classList.contains('d-none');
                    moreBuildings.classList.toggle('d-none', !isHidden);
                    showMoreBuildings.textContent = isHidden ? 'Show fewer' : `Load more (${moreBuildings.querySelectorAll('button').length})`;
                });
            }
        </script>
    }
