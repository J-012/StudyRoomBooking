```razor
@model List<StudyRoomBooking.Models.Room>

@{
    ViewData["Title"] = "Study Rooms";
}

<div class="py-5">
    <span class="text-uppercase text-secondary small fw-semibold">
        Facilities
    </span>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2">
        <div>
            <h1 class="h2 fw-bold mt-1 mb-2">Study Rooms</h1>
            <p class="text-secondary mb-0">
                Find a comfortable space for your next study session.
            </p>
        </div>
        <div>
            <span class="badge rounded-pill border px-3 py-2 text-dark" style="background-color: var(--srb-hero-bg);">
                @Model.Count @(Model.Count == 1 ? "room" : "rooms") available
            </span>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Rooms" asp-action="Create" class="btn btn-primary">
                    + Add Room
                </a>
            }
        </div>
    </div>
</div>
<form asp-controller="Rooms" asp-action="Index" method="get" class="card border rounded-3 p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-4">
            <label for="searchTerm" class="form-label">Search rooms</label>
            <input type="text"
                   id="searchTerm"
                   name="searchTerm"
                   value="@ViewBag.SearchTerm"
                   class="form-control"
                   placeholder="Room number or building" />
        </div>

        <div class="col-12 col-md-3">
            <label for="building" class="form-label">Building</label>
            <select id="building" name="building" class="form-select">
                <option value="">All buildings</option>
                <option value="Pilestredet 32" selected="@(ViewBag.Building as string == "Pilestredet 32")">
                    Pilestredet 32
                </option>
                <option value="Pilestredet 35" selected="@(ViewBag.Building as string == "Pilestredet 35")">
                    Pilestredet 35
                </option>
            </select>
        </div>

        <div class="col-12 col-md-3">
            <label for="minCapacity" class="form-label">Minimum capacity</label>
            <input type="number"
                   id="minCapacity"
                   name="minCapacity"
                   value="@ViewBag.MinCapacity"
                   min="1"
                   class="form-control"
                   placeholder="Number of seats" />
        </div>

        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                Search
            </button>
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </div>
</form>

@if (Model.Count > 0)
{
    <div class="row g-3">
        @foreach (var room in Model)
        {
            <div class="col-6 col-md-4 ">
                <div class="card room-card h-100">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="room-number">
                                <span class="small text-secondary d-block mb-1">
                                    STUDY ROOM
                                </span>
                                <h2 class="h4 fw-bold mb-0">
                                    @room.RoomNumber
                                </h2>
                            </div>

                            <span class="room-capacity">
                                <span class="fw-semibold">
                                    @room.Capacity
                                </span>
                                <span class="small">
                                    @(room.Capacity == 1 ? "seat" : "seats")
                                </span>
                            </span>
                        </div>

                        <div class="border-top pt-3 mt-3">
                            <p class="small text-secondary mb-1">
                                Building
                            </p>
                            <p class="fw-semibold mb-0">
                                @room.Building
                            </p>
                        </div>
                    </div>

                    <div class="card-footer px-3 px-md-4 pb-3 pb-md-4 pt-0">
                        <div class="d-flex align-items-center gap-2">
                            <a asp-controller="Bookings"
                               asp-action="Create"
                               class="btn btn-room flex-grow-1 fw-semibold">
                                Book this room
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Rooms"
                                   asp-action="Edit"
                                   asp-route-id="@room.Id"
                                   class="btn btn-room">
                                    Edit
                                </a>

                                <form asp-controller="Rooms"
                                      asp-action="Delete"
                                      asp-route-id="@room.Id"
                                      method="post"
                                      class="m-0"
                                      onsubmit="return confirm('Are you sure you want to delete this room?');">

                                    <button type="submit" class="btn btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border rounded-3 shadow-sm">
        <div class="card-body text-center py-5 px-4">
            <h2 class="h5 fw-bold mb-2">No study rooms available</h2>
            <p class="text-secondary mb-4">
                There are no rooms registered yet. Please check back later.
            </p>
            <a asp-controller="Rooms"
               asp-action="Index"
               class="btn btn-room fw-semibold px-4">
                Clear filters
            </a>
        </div>
    </div>
}