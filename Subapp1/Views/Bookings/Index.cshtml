@using System.Security.Claims
@model List<StudyRoomBooking.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
    var now = DateTime.Now;
}

<section class="py-4 py-lg-5">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 border-bottom pb-4 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">My bookings</h1>
            <p class="text-secondary-emphasis mb-0">
                @if (Model.Count == 0)
                {
                    <span>You do not have any room reservations yet.</span>
                }
                else
                {
                    <span>@Model.Count @(Model.Count == 1 ? "reservation" : "reservations") in your schedule.</span>
                }
            </p>
        </div>
        <a class="btn btn-primary align-self-sm-center px-3" asp-action="Create">New booking</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body py-5 text-center">
                <h2 class="h5 fw-bold">No bookings yet</h2>
                <p class="text-secondary-emphasis mb-4">When you reserve a study room, it will appear here.</p>
                <a class="btn btn-primary px-4" asp-action="Create">Reserve a room</a>
            </div>
        </div>
    }
    else
    {
        <div class="d-none d-md-block card shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Session</th>
                            <th scope="col">When</th>
                            <th scope="col">Room</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.OrderBy(booking => booking.EndTime <= now).ThenBy(booking => booking.StartTime))
                        {
                            var isPast = booking.EndTime <= now;
                            var isOngoing = !isPast && booking.StartTime <= now;
                            var statusText = isPast ? "Completed" : isOngoing ? "In progress" : "Upcoming";
                            var statusClass = isPast ? "bg-secondary-subtle text-secondary-emphasis" : isOngoing ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis";

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold">@(booking.Course?.Name ?? booking.CourseCode ?? "Study session")</div>
                                    <small class="text-secondary">@booking.CourseCode · @booking.Topic</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@booking.StartTime.ToString("ddd, dd MMM")</div>
                                    <small class="text-secondary">@booking.StartTime.ToString("HH:mm") – @booking.EndTime.ToString("HH:mm")</small>
                                </td>
                                <td>Room @booking.RoomId</td>
                                <td><span class="badge rounded-pill @statusClass">@statusText</span></td>
                                <td class="text-end pe-4">
                                    @if (booking.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@booking.BookingId">Edit</a>
                                        <form asp-action="Delete" asp-route-id="@booking.BookingId" method="post" class="d-inline" onsubmit="return confirm('Delete this booking?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1">Delete</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-md-none vstack gap-3">
            @foreach (var booking in Model.OrderBy(booking => booking.EndTime <= now).ThenBy(booking => booking.StartTime))
            {
                var isPast = booking.EndTime <= now;
                var isOngoing = !isPast && booking.StartTime <= now;
                var statusText = isPast ? "Completed" : isOngoing ? "In progress" : "Upcoming";
                var statusClass = isPast ? "bg-secondary-subtle text-secondary-emphasis" : isOngoing ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis";

                <article class="card shadow-sm">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 class="h6 fw-bold mb-1">@(booking.Course?.Name ?? booking.CourseCode ?? "Study session")</h2>
                                <p class="small text-secondary mb-0">@booking.CourseCode · @booking.Topic</p>
                            </div>
                            <span class="badge rounded-pill @statusClass">@statusText</span>
                        </div>
                        <div class="row g-2 small border-top pt-3">
                            <div class="col-7"><span class="d-block text-secondary">When</span><strong>@booking.StartTime.ToString("ddd, dd MMM")</strong><br />@booking.StartTime.ToString("HH:mm") – @booking.EndTime.ToString("HH:mm")</div>
                            <div class="col-5"><span class="d-block text-secondary">Room</span><strong>Room @booking.RoomId</strong></div>
                        </div>
                        @if (booking.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                        {
                            <div class="d-flex justify-content-end gap-2 border-top mt-3 pt-3">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@booking.BookingId">Edit</a>
                                <form asp-action="Delete" asp-route-id="@booking.BookingId" method="post" class="d-inline" onsubmit="return confirm('Delete this booking?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
