@using System.Security.Claims
@model List<StudyRoomBooking.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
    var now = DateTime.Now;
    var upcomingCount = Model.Count(booking => booking.StartTime > now);
    var activeCount = Model.Count(booking => booking.StartTime <= now && booking.EndTime > now);
    var completedCount = Model.Count(booking => booking.EndTime <= now);
}

<section class="py-4 py-lg-5">
    <div class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-3 mb-4">
        <div>
            <span class="section-eyebrow">Your schedule</span>
            <h1 class="display-6 fw-bold mt-2 mb-2">Study sessions</h1>
            <p class="text-secondary-emphasis mb-0">Keep your room reservations organised and up to date.</p>
        </div>
        <a class="btn btn-primary px-3 py-2" asp-action="Create">+ New booking</a>
    </div>

    <div class="row g-3 mb-4" aria-label="Booking summary">
        <div class="col-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3"><small class="text-uppercase text-secondary fw-semibold">Total
                    sessions</small>
                    <div class="fs-2 fw-bold mt-2">@Model.Count</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3"><small class="text-uppercase text-secondary fw-semibold">Upcoming</small>
                    <div class="fs-2 fw-bold mt-2">@upcomingCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 border-success-subtle bg-success-subtle shadow-sm">
                <div class="card-body p-3"><small class="text-uppercase text-success-emphasis fw-semibold">In
                    progress</small>
                    <div class="fs-2 fw-bold mt-2">@activeCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-3"><small class="text-uppercase text-secondary fw-semibold">Completed</small>
                    <div class="fs-2 fw-bold mt-2">@completedCount</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card text-center">
            <div class="card-body py-5 px-4">
                <div class="d-inline-block rounded-circle bg-warning-subtle fs-3 lh-1 p-3 mb-3">+</div>
                <h2 class="h4 fw-bold mb-2">No study sessions yet</h2>
                <p class="text-secondary-emphasis w-75 mx-auto mb-4">Reserve a room to add your first study session to this
                    schedule.</p>
                    <a class="btn btn-primary px-4" asp-action="Create">Create a booking</a>
                </div>
            </div>
        }
    else
        {
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="h5 fw-bold mb-0">Your reservations</h2>
                <span class="text-secondary-emphasis small">@Model.Count @(Model.Count == 1 ? "booking" : "bookings")</span>
            </div>

            <div class="row g-3 g-lg-4">
                @foreach (var booking in Model.OrderBy(booking => booking.EndTime <= now).ThenBy(booking => booking.StartTime))
                {
                    var isPast = booking.EndTime <= now;
                    var isOngoing = !isPast && booking.StartTime <= now;
                    var statusText = isPast ? "Completed" : isOngoing ? "In progress" : "Upcoming";
                    var statusClass = isPast ? "text-bg-secondary" : isOngoing ? "text-bg-success" : "text-bg-warning";
                    var duration = booking.EndTime - booking.StartTime;
                    var durationText = duration.TotalHours >= 1 ? $"{(int)duration.TotalHours}h {duration.Minutes:D2}m" :
            $"{duration.Minutes} min";

                    <div class="col-12 col-xl-6">
                        <article
                            class="card h-100 shadow-sm border-start border-2 @(isPast ? "border-secondary bg-body-tertiary" : "border-warning")">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start justify-content-between gap-3">
                                    <div>
                                        <small class="fw-bold text-uppercase text-secondary">@booking.CourseCode</small>
                                        <h3 class="h5 fw-bold mt-2 mb-1">@(booking.Course?.Name ?? "Study session")</h3>
                                        <p class="text-secondary-emphasis mb-0">@booking.Topic</p>
                                    </div>
                                    <span class="badge rounded-pill @statusClass">@statusText</span>
                                </div>

                                <div class="row g-3 border-top border-bottom py-3 my-4">
                                    <div class="col-6 col-md-4"><small
                                        class="d-block text-uppercase text-secondary fw-semibold mb-1">Date</small><strong
                                        class="small">@booking.StartTime.ToString("ddd, dd MMM yyyy")</strong></div>
                                        <div class="col-6 col-md-4"><small
                                            class="d-block text-uppercase text-secondary fw-semibold mb-1">Time</small><strong
                                            class="d-block small">@booking.StartTime.ToString("HH:mm") –
                                            @booking.EndTime.ToString("HH:mm")</strong><small
                                            class="text-secondary">@durationText</small></div>
                                            <div class="col-12 col-md-4"><small
                                                class="d-block text-uppercase text-secondary fw-semibold mb-1">Room</small><strong
                                                class="small">Room @booking.RoomId</strong></div>
                                            </div>

                                            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
                                                <small class="text-secondary text-truncate">Reserved by @booking.UserName</small>
                                                @if (booking.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                                                {
                                                    <div class="d-flex gap-2 align-self-sm-auto">
                                                        <a class="btn btn-sm btn-outline-dark" asp-action="Edit"
                                                           asp-route-id="@booking.BookingId">Edit</a>
                                                        <form asp-action="Delete" asp-route-id="@booking.BookingId" method="post" class="d-inline"
                                                              onsubmit="return confirm('Delete this booking?');">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </article>
                                </div>
                            }
                        </div>
                    }
                </section>
