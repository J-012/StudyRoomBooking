@model StudyRoomBooking.Models.BookingFormViewModel

<div class="card mb-4">
    <div class="card-body p-4">
        <h2 class="h5 fw-bold mb-4">Session details</h2>

        <div class="row g-3">

            <div class="col-12 col-md-6">
                <label asp-for="CourseCode" class="form-label">
                    Course
                </label>

                <select asp-for="CourseCode" class="form-select">
                    <option value="">Select a course</option>

                    @foreach (var course in Model.Courses)
                    {
                        <option value="@course.CourseCode">
                            @course.CourseCode - @course.Name
                        </option>
                    }
                </select>

                <span asp-validation-for="CourseCode" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Topic" class="form-label"></label>
                <input asp-for="Topic" class="form-control" />
                <span asp-validation-for="Topic" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="RoomId" class="form-label">
                    Study Room
                </label>

                <select asp-for="RoomId" class="form-select">
                    <option value="">Select a room</option>

                    @foreach (var room in Model.Rooms)
                    {
                        <option value="@room.Id">
                            @room.Building - Room @room.RoomNumber
                        </option>
                    }
                </select>

                <span asp-validation-for="RoomId" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="StartDate" class="form-label">
                    Date
                </label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="StartClock" class="form-label">
                    Start time
                </label>
                <input asp-for="StartClock" type="time" step="900" class="form-control" />
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="EndClock" class="form-label">
                    End time
                </label>
                <input asp-for="EndClock" type="time" step="900" class="form-control" />
            </div>

        </div>
    </div>
</div>